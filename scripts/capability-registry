#!/bin/sh
# Resolve this script even when invoked through ~/.agents/bin/capability-registry.
source=$0
case $source in
    */*) ;;
    *) source=$(command -v "$source") || exit 1 ;;
esac
link_hops=0
while [ -L "$source" ]; do
    link_hops=$((link_hops + 1))
    if [ "$link_hops" -gt 40 ]; then
        printf '%s\n' "status: error" "summary: capability-registry launcher symlink loop detected" >&2
        exit 1
    fi
    source_dir=$(CDPATH= cd -P "$(dirname "$source")" && pwd) || exit 1
    target=$(readlink "$source") || exit 1
    case $target in
        /*) source=$target ;;
        *) source=$source_dir/$target ;;
    esac
done
script_dir=$(CDPATH= cd -P "$(dirname "$source")" && pwd) || exit 1
registry=$script_dir/capability_registry.py

supports_python() {
    "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1
}

run_registry() {
    interpreter=$1
    shift
    exec "$interpreter" "$registry" "$@"
}

if [ -n "${CAPABILITY_ROUTER_PYTHON:-}" ]; then
    if supports_python "$CAPABILITY_ROUTER_PYTHON"; then
        run_registry "$CAPABILITY_ROUTER_PYTHON" "$@"
    fi
    printf '%s\n' "status: error" "summary: capability router requires Python 3.11+; CAPABILITY_ROUTER_PYTHON is unavailable or unsupported" >&2
    exit 1
fi

for candidate in python3 python3.14 python3.13 python3.12 python3.11; do
    if command -v "$candidate" >/dev/null 2>&1 && supports_python "$candidate"; then
        run_registry "$candidate" "$@"
    fi
done

printf '%s\n' "status: error" "summary: capability router requires Python 3.11+; no supported Python interpreter was found" >&2
exit 1
